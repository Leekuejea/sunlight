{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunlight",
  "version": "1.2.0",
  "identifier": "app.sunlight.reader",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/doclayout.onnx": "doclayout.onnx"
    },
    "category": "Education",
    "shortDescription": "논문을 레이아웃 그대로 번역해 읽는 앱",
    "macOS": {
      "minimumSystemVersion": "13.4",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRDFBQTg3MTZDNjczN0QKUldSOWM4WVdoNnJSb2MxQXV1OWRSTWRtWnJ2dk9tOUpyVUtSdFltbVYxTDFLUGZBRWtwbTNtRW0K",
      "endpoints": [
        "https://github.com/Leekuejea/sunlight/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
